        <button onclick="forceRefresh()" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:8px;cursor:pointer;padding:6px;display:flex">
          <svg id="refresh-icon-adm" width="15" height="15" fill="none" stroke="rgba(255,255,255,.6)" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </button>
        <div style="display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:4px 10px">
          <svg width="12" height="12" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span id="adm-user-nombre" style="font-size:12px;color:rgba(255,255,255,.6)"></span>
        </div>
        <button onclick="doLogout()" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:8px;cursor:pointer;padding:6px 10px;font-size:11px;font-weight:700;color:#fca5a5;font-family:inherit">Salir</button>
      </div>
    </div>
    <div style="display:flex;flex:1;overflow:hidden;min-height:0">
      <div id="adm-sidebar" style="width:200px;background:#0f172a;border-right:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;padding:8px;flex-shrink:0;overflow-y:auto">
        <button class="adm-icon-btn active" data-sec="torneo" onclick="admToggleSection('torneo',this)">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="2"/><path d="M12 10v4M8 14h8M6 20h12"/></svg>
          Torneo<svg class="chv" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="adm-submenu-inner open" id="sub-torneo">
          <button class="adm-sub-item active" onclick="admSetTab('tab-ligas',this)">Ligas</button>
          <button class="adm-sub-item" onclick="admSetTab('tab-equipos',this)">Equipos</button>
          <button class="adm-sub-item" onclick="admSetTab('tab-partidos',this)">Partidos</button>
          <button class="adm-sub-item" onclick="admSetTab('tab-res-adm',this)">Resultados</button>
        </div>
        <button class="adm-icon-btn" data-sec="sanciones" onclick="admToggleSection('sanciones',this)">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/></svg>
          Sanciones<svg class="chv" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="adm-submenu-inner" id="sub-sanciones">
          <button class="adm-sub-item" onclick="admSetTab('tab-sanciones-adm',this)">Registrar</button>
        </div>
        <button class="adm-icon-btn" data-sec="reportes" onclick="admToggleSection('reportes',this)">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Reportes<svg class="chv" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
