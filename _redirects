.adm-grid-card:active{border-color:#60a5fa;background:#1a2333}
.adm-grid-card-icon{width:38px;height:38px;border-radius:11px;background:rgba(30,58,138,.5);border:1px solid rgba(99,102,241,.25);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.adm-grid-card-icon svg{width:18px;height:18px;stroke:#93c5fd}
.adm-grid-card-title{font-family:'Archivo Black',sans-serif;font-size:14px;color:#fff;letter-spacing:-.3px;line-height:1.2}
.adm-grid-card-sub{font-size:11px;color:rgba(255,255,255,.35);line-height:1.3;margin-top:-4px}
/* Botón volver en mobile */
