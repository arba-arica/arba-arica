    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div style="position:absolute;left:50%;transform:translateX(-50%);font-family:'Archivo Black',sans-serif;font-size:13px;letter-spacing:1.5px;color:#fff">BASQUET XV REGIÓN</div>
  <div style="display:flex;align-items:center;gap:8px">
    <button onclick="forceRefresh()" style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.8)">
      <svg id="refresh-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
    </button>
    <button id="admin-btn"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 20v-2a6 6 0 0112 0v2"/></svg></button>
  </div>
</header>

<div id="drawer-overlay" onclick="closeDrawer()">
  <div id="drawer" onclick="event.stopPropagation()">
    <div class="drawer-top">
      <div style="font-family:'Archivo Black',sans-serif;font-size:18px;color:var(--primary)">ARBA</div>
      <div style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted2);margin-top:1px">Arica · Temporada 2026</div>
    </div>
    <div class="drawer-nav">
      <div class="drawer-section">Inicio</div>
      <button class="drawer-item" onclick="volverInicio();closeDrawer()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Volver al inicio
      </button>
      <div class="drawer-section">Documentos</div>
      <button class="drawer-item" onclick="abrirReglamento()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Reglamento Torneo
      </button>
    </div>
  </div>
</div>

<div id="content">
  <div id="sec-sanciones" class="section">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px"><div style="font-family:'Archivo Black',sans-serif;font-size:22px;letter-spacing:-.5px">Sanciones<span style="color:var(--orange)">.</span></div></div>
    <div id="sanciones-list"></div>
  </div>
  <div id="sec-reportes" class="section">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px"><div style="font-family:'Archivo Black',sans-serif;font-size:22px;letter-spacing:-.5px">Reportes<span style="color:var(--orange)">.</span></div></div>
    <div class="reporte-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div><div style="font-family:'Archivo Black',sans-serif;font-size:15px">📅 Fixture</div><div style="font-size:11px;color:var(--muted);margin-top:2px">Partidos por disputar</div></div>
        <button class="pdf-btn" onclick="downloadPDF('fixture')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>PDF</button>
      </div>
      <label class="f-label">Liga</label>
      <select class="f-select" id="rep-liga-fixture" style="margin-bottom:8px;font-size:13px;padding:8px 10px" onchange="updateRepEquipos('fixture')"></select>
      <label class="f-label">Equipo</label>
      <select class="f-select" id="rep-eq-fixture" style="margin-bottom:0;font-size:13px;padding:8px 10px"></select>
    </div>
    <div class="reporte-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div><div style="font-family:'Archivo Black',sans-serif;font-size:15px">🏆 Resultados</div><div style="font-size:11px;color:var(--muted);margin-top:2px">Partidos finalizados</div></div>
        <button class="pdf-btn" onclick="downloadPDF('resultados')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>PDF</button>
      </div>
      <label class="f-label">Liga</label>
      <select class="f-select" id="rep-liga-res" style="margin-bottom:8px;font-size:13px;padding:8px 10px" onchange="updateRepEquipos('res')"></select>
      <label class="f-label">Equipo</label>
      <select class="f-select" id="rep-eq-res" style="margin-bottom:0;font-size:13px;padding:8px 10px"></select>
    </div>
    <div class="reporte-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <div><div style="font-family:'Archivo Black',sans-serif;font-size:15px">📊 Posiciones</div><div style="font-size:11px;color:var(--muted);margin-top:2px">Tabla de posiciones</div></div>
        <button class="pdf-btn" onclick="downloadPDF('puntaje')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>PDF</button>
      </div>
      <label class="f-label">Liga</label>
      <select class="f-select" id="rep-liga-pts" style="margin-bottom:0;font-size:13px;padding:8px 10px"></select>
    </div>
  </div>
</div>

<!-- MODAL NOTICIA -->
<div class="noticia-modal-overlay" id="noticia-modal-overlay">
  <div class="noticia-modal">
    <div style="width:100%;aspect-ratio:16/9;background:linear-gradient(135deg,var(--primary),#1e40af);display:flex;align-items:center;justify-content:center;font-size:56px" id="nm-img"><span id="nm-emoji">🏀</span></div>
    <div class="nm-body">
      <div style="display:flex;align-items:center;gap:14px;padding:12px 0;border-bottom:1px solid var(--border);margin-bottom:12px">
        <button class="news-like-btn" id="nm-like-btn" onclick="toggleLikeModal()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span id="nm-likes">0</span>
        </button>
      </div>
      <div style="font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px" id="nm-date"></div>
      <div class="nm-title" id="nm-title"></div>
      <div style="font-size:13px;color:var(--muted);line-height:1.6" id="nm-desc"></div>
      <button class="nm-close" onclick="closeNoticiaModal()">Cerrar</button>
    </div>
  </div>
</div>

<!-- CONFIRM V3 -->
<div class="confirm-v3-overlay" id="confirm-v3-overlay">
  <div class="confirm-v3-box">
    <div class="confirm-v3-icon" id="cv3-icon">⚠️</div>
    <div class="confirm-v3-title" id="cv3-title">¿Confirmar acción?</div>
    <div class="confirm-v3-desc" id="cv3-desc"></div>
