  const lWin=isFinal&&gl>gv,vWin=isFinal&&gv>gl;
  const liga=ligaObj(p.ID_Liga);
  const statusCls=isCuarto?'status-cuarto':(isFinal?'status-final':'status-prog');
  const statusTxt=isCuarto?('<span class="live-dot"></span>'+p.Estado):(isFinal?'Final':'Programado');
  const cardCls=isCuarto?'live':(isFinal?'final':'prog');
  const scoreBlock=p.Estado==='Programado'?'<div class="score-vs">VS</div>':`<div class="score-nums"><span class="score-n${isCuarto?' live':lWin?' winner':''}">${gl}</span><span class="score-sep">-</span><span class="score-n${isCuarto?' live':vWin?' winner':''}">${gv}</span></div>`;
  const faseBadge=(p.Fase&&p.Fase!=='Regular')?` · <span style="color:var(--orange);font-weight:700">${p.Fase}</span>`:'';
  return`<div class="match-card ${cardCls}">
    <div style="background:var(--primary-light);padding:6px 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);margin:-12px -14px 10px">
