          <div style="font-size:12px;font-weight:700;color:#f97316">📋 Ver toda la programación</div>
          <div style="font-size:10px;color:rgba(249,115,22,.6)">Todas las ligas</div>
        </button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px" id="splash-ligas-grid">
        <div style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:12px"><div style="font-size:11px;color:rgba(255,255,255,.4)">Cargando ligas...</div></div>
