    <div style="font-family:'Archivo Black',sans-serif;font-size:18px;letter-spacing:3px;color:#fff">BASQUET XV REGIÓN</div>
    <div style="font-size:10px;color:rgba(255,255,255,.5);letter-spacing:2px;margin-top:2px">ARICA · CHILE</div>
    <div style="width:100%;height:1px;background:rgba(255,255,255,.1);margin:14px 0 12px"></div>
    <div style="font-size:11px;font-weight:700;letter-spacing:2px;color:#f97316;margin-bottom:4px">TEMPORADA 2026</div>
