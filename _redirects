    </div>
  </div>
  <div style="padding:14px 16px 40px;flex:1" id="splash-content">
    <div style="text-align:center;padding:40px 0"><div style="font-size:13px;color:rgba(255,255,255,.3)">Selecciona una liga para ver el contenido</div></div>
  </div>
</div>

<header id="app-header" style="background:var(--primary);padding:0 16px;height:52px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100">
