      <button id="do-login" style="width:100%;padding:13px;border-radius:10px;background:#1e3a8a;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;cursor:pointer;border:none;margin-top:4px"><span id="login-btn-txt">Ingresar →</span></button>
