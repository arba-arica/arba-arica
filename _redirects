<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{--bg:#f1f5f9;--surface:#fff;--card:#fff;--border:#e2e8f0;--border2:#cbd5e1;--primary:#1e3a8a;--primary-h:#1e40af;--primary-light:#eff6ff;--orange:#f97316;--orange-light:#fff7ed;--red:#dc2626;--red-light:#fef2f2;--green:#16a34a;--green-light:#f0fdf4;--text:#1e293b;--muted:#64748b;--muted2:#94a3b8;--r:12px;}
html,body{background:var(--bg);color:var(--text);font-family:'Archivo',sans-serif;min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:0;height:0}
#app-header,#drawer-overlay,#main-nav,.section,#sec-sanciones,#sec-reportes{display:none!important}
#admin-btn{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.8)}
#admin-btn svg{width:18px;height:18px}
#content{padding:16px 16px 90px}
.section{display:none}
.section.active{display:block;animation:fadeUp .2s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.st-table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;font-size:12px}
.st-table th{background:#f8fafc;color:var(--muted2);font-size:10px;font-weight:700;padding:8px 6px;text-align:center;letter-spacing:.8px;text-transform:uppercase;border-bottom:1px solid var(--border)}
.st-table th:nth-child(2){text-align:left;padding-left:10px}
.st-table td{padding:10px 6px;text-align:center;border-bottom:1px solid #f1f5f9;color:var(--muted);font-weight:500}
.st-table tr:last-child td{border-bottom:none}
.st-table tr:hover td{background:#fafbff}
.st-table td:nth-child(2){text-align:left;padding-left:10px;font-weight:700;font-size:13px;color:var(--text)}
.rk{font-family:'Archivo Black',sans-serif;font-size:14px}
.rk.g{color:var(--orange)}.rk.s{color:#94a3b8}.rk.b{color:#b45309}
.pts-cell{font-family:'Archivo Black',sans-serif;font-size:15px;color:var(--primary)}
.dif-pos{color:var(--green)}.dif-neg{color:var(--red)}
.match-card{background:#fafbff;border:1px solid var(--border);border-left:3px solid var(--border2);border-radius:var(--r);padding:12px 14px;margin-bottom:8px}
.match-card.live{border-left-color:var(--red)}.match-card.final{border-left-color:var(--primary)}.match-card.prog{border-left-color:var(--green)}
.match-status{font-size:10px;font-weight:700;letter-spacing:.8px;padding:2px 8px;border-radius:100px;text-transform:uppercase}
.status-live{background:var(--red-light);color:var(--red);border:1px solid #fecaca}
.status-final{background:var(--primary-light);color:var(--primary);border:1px solid #bfdbfe}
.status-prog{background:var(--green-light);color:var(--green);border:1px solid #bbf7d0}
.status-cuarto{background:var(--orange-light);color:var(--orange);border:1px solid #fed7aa}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--orange);display:inline-block;margin-right:4px;animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.match-body{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:6px}
.team-side{display:flex;flex-direction:column;gap:4px}
.team-side.right{text-align:right;align-items:flex-end}
.team-color{width:20px;height:3px;border-radius:2px;background:var(--border2)}
.team-name{font-family:'Archivo Black',sans-serif;font-size:14px;letter-spacing:-.3px;line-height:1.2;color:var(--text)}
.team-name.winner{color:var(--primary)}
.score-block{text-align:center}
.score-nums{font-family:'Archivo Black',sans-serif;font-size:30px;letter-spacing:-2px;line-height:1;display:flex;align-items:center;gap:3px;justify-content:center}
.score-n{color:var(--text)}.score-n.live{color:var(--red)}.score-n.winner{color:var(--primary)}
.score-sep{color:var(--muted2);font-size:18px;font-family:'Archivo Black',sans-serif}
.score-vs{font-size:11px;font-weight:700;color:var(--muted2);letter-spacing:2px}
.match-footer{margin-top:10px;padding-top:8px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.match-info{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:4px}
.match-expand{display:none;margin-top:8px;padding-top:8px;border-top:1px solid var(--border)}
.match-expand.open{display:block}
.exp-row{display:flex;justify-content:space-between;font-size:12px;padding:2px 0;color:var(--muted)}
.exp-row span:last-child{color:var(--text);font-weight:600}
.chevron{transition:transform .25s;color:var(--muted2);cursor:pointer}
.chevron.open{transform:rotate(180deg)}
.chevron svg{width:14px;height:14px}
.yt-link{font-size:10px;font-weight:700;color:var(--red);text-decoration:none;display:flex;align-items:center;gap:3px}
.reporte-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px;margin-bottom:12px}
.pdf-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:100px;background:var(--orange-light);color:var(--orange);border:1px solid #fed7aa;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap}
.pdf-btn svg{width:13px;height:13px}
.noticia-modal-overlay{position:fixed;inset:0;z-index:500;background:rgba(15,23,42,.85);display:none;align-items:flex-end;justify-content:center}
.noticia-modal-overlay.open{display:flex}
.noticia-modal{background:var(--surface);border-radius:22px 22px 0 0;width:100%;max-width:640px;max-height:92vh;overflow-y:auto;animation:slideUp .3s cubic-bezier(.32,1,.4,1);padding-bottom:24px}
.nm-body{padding:16px 18px}
.nm-title{font-family:'Archivo Black',sans-serif;font-size:18px;color:var(--primary);margin-bottom:8px;line-height:1.3}
.nm-wa{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:13px;border-radius:12px;background:#25D366;color:#fff;font-weight:700;font-size:13px;border:none;cursor:pointer}
.nm-close{width:100%;padding:12px;background:none;border:none;color:var(--muted);font-weight:700;font-size:13px;cursor:pointer;margin-top:4px}
.news-like-btn{display:flex;align-items:center;gap:5px;background:none;border:none;cursor:pointer;font-size:13px;font-weight:700;color:var(--muted);padding:0}
.news-like-btn.liked{color:var(--red)}
.news-like-btn svg{width:18px;height:18px}
/* ADMIN */
#admin-overlay{position:fixed;inset:0;z-index:200;background:#0a0e1f;display:none}
#admin-overlay.open{display:flex;flex-direction:column}
.adm-icon-btn{width:100%;padding:10px 12px;border-radius:8px;background:transparent;border:none;cursor:pointer;display:flex;align-items:center;gap:10px;color:rgba(255,255,255,.45);transition:all .15s;font-size:13px;font-family:inherit;text-align:left}
.adm-icon-btn:hover{background:rgba(255,255,255,.06);color:rgba(255,255,255,.85)}
.adm-icon-btn.active{background:rgba(30,58,138,.4);color:#93c5fd;font-weight:600}
.adm-icon-btn svg{width:16px;height:16px;flex-shrink:0}
.adm-icon-btn .chv{margin-left:auto;width:14px;height:14px;transition:transform .2s;opacity:.4}
.adm-icon-btn.active .chv{transform:rotate(180deg);opacity:.8}
.adm-submenu-inner{overflow:hidden;transition:max-height .25s ease;max-height:0}
.adm-submenu-inner.open{max-height:300px}
.adm-sub-item{display:flex;align-items:center;padding:7px 12px 7px 38px;border-radius:6px;cursor:pointer;font-size:12px;color:rgba(255,255,255,.35);margin-bottom:1px;border:none;background:transparent;width:100%;text-align:left;transition:all .15s}
.adm-sub-item:hover{background:rgba(255,255,255,.05);color:rgba(255,255,255,.7)}
.adm-sub-item.active{background:rgba(30,58,138,.35);color:#93c5fd;font-weight:600}
.adm-panel-new{background:#0a0e1f}
.adm-panel-new .f-input,.adm-panel-new .f-select{background:#111827;border-color:rgba(255,255,255,.1);color:#fff}
.adm-panel-new .f-input::placeholder{color:rgba(255,255,255,.25)}
.adm-panel-new .f-input:focus,.adm-panel-new .f-select:focus{border-color:#3b82f6}
.adm-panel-new .f-label{color:rgba(255,255,255,.45)}
.adm-panel-new .f-select option{background:#111827;color:#fff}
.adm-panel-new .adm-sec-label{color:rgba(255,255,255,.3);border-bottom:1px solid rgba(255,255,255,.06);padding-bottom:6px}
.adm-panel-new .adm-list-item{background:#111827;border-color:rgba(255,255,255,.08)}
.adm-panel-new .adm-list-name{color:#fff}
.adm-panel-new .adm-list-sub{color:rgba(255,255,255,.4)}
.adm-form-card{background:#111827;border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px;margin-bottom:16px}
.adm-form-title{font-family:'Archivo Black',sans-serif;font-size:14px;color:#fff;margin-bottom:14px}
.adm-btn-primary{width:100%;padding:12px;border-radius:10px;background:#1e3a8a;color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:13px;cursor:pointer;border:none;transition:background .2s;display:flex;align-items:center;justify-content:center;gap:6px}
.adm-btn-primary:hover{background:#1d4ed8}
.adm-btn-secondary{padding:8px 14px;border-radius:8px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.7);font-family:'Archivo',sans-serif;font-weight:700;font-size:12px;cursor:pointer;border:1px solid rgba(255,255,255,.1)}
.adm-btn-danger{padding:6px 10px;border-radius:7px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);color:#fca5a5;font-size:11px;font-weight:700;cursor:pointer}
.adm-list-item{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:#111827;border:1px solid rgba(255,255,255,.08);border-radius:10px;margin-bottom:6px}
.adm-list-name{font-size:13px;font-weight:700;color:#fff}
.adm-list-sub{font-size:11px;color:rgba(255,255,255,.4);margin-top:2px;display:flex;align-items:center;gap:5px}
.score-in{width:54px;padding:9px 4px;text-align:center;background:#1e2332;border:1.5px solid rgba(255,255,255,.15);border-radius:9px;color:#fff;font-family:'Archivo Black',sans-serif;font-size:22px;outline:none;-moz-appearance:textfield}
.score-in:focus{border-color:#3b82f6}
.score-in::-webkit-inner-spin-button,.score-in::-webkit-outer-spin-button{-webkit-appearance:none}
#modal-overlay{position:fixed;inset:0;z-index:300;background:rgba(15,23,42,.7);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px}
#modal-overlay.open{display:flex}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;width:100%;max-width:420px;max-height:90vh;overflow-y:auto;padding:24px}
.modal-title{font-family:'Archivo Black',sans-serif;font-size:18px;letter-spacing:-.5px;margin-bottom:18px;color:var(--primary)}
.modal-actions{display:flex;gap:8px;margin-top:16px}
.confirm-v3-overlay{position:fixed;inset:0;z-index:600;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);display:none;align-items:flex-end;justify-content:center}
.confirm-v3-overlay.open{display:flex}
.confirm-v3-box{background:var(--surface);border-radius:22px 22px 0 0;width:100%;max-width:640px;padding:24px 20px 32px;animation:slideUp .3s cubic-bezier(.32,1,.4,1)}
.confirm-v3-icon{font-size:36px;text-align:center;margin-bottom:10px}
.confirm-v3-title{font-family:'Archivo Black',sans-serif;font-size:18px;text-align:center;margin-bottom:6px}
.confirm-v3-desc{font-size:13px;color:var(--muted);text-align:center;line-height:1.5;margin-bottom:20px}
.confirm-v3-btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.conf-v3-cancel{padding:13px;border-radius:10px;background:var(--bg);color:var(--muted);border:1.5px solid var(--border);font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;cursor:pointer}
.conf-v3-ok{padding:13px;border-radius:10px;background:var(--primary);color:#fff;border:none;font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px}
.conf-v3-ok.danger{background:var(--red)}.conf-v3-ok.ok-green{background:var(--green)}
.conf-v3-ok:disabled{opacity:.6;cursor:not-allowed}
.f-label{font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.6px;text-transform:uppercase;margin-bottom:6px;display:block}
.f-input,.f-select{width:100%;background:var(--bg);border:1.5px solid var(--border);border-radius:10px;color:var(--text);padding:11px 14px;font-family:'Archivo',sans-serif;font-size:15px;outline:none;transition:border-color .2s;margin-bottom:14px;-webkit-appearance:none}
.f-input:focus,.f-select:focus{border-color:var(--primary)}
.f-select option{background:var(--surface)}
textarea.f-input{resize:none}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.login-error{font-size:13px;color:var(--red);margin-bottom:12px;display:none;font-weight:600}
.btn-primary{width:100%;padding:13px;border-radius:10px;background:var(--primary);color:#fff;font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;cursor:pointer;border:none;display:flex;align-items:center;justify-content:center;gap:6px}
.btn-ghost{width:100%;padding:12px;border-radius:10px;background:transparent;color:var(--muted);border:1.5px solid var(--border);font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;cursor:pointer}
.adm-sec-label{font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:.6px;text-transform:uppercase;margin:16px 0 10px}
.del-btn{padding:5px 10px;background:var(--red-light);border:1px solid #fecaca;border-radius:7px;color:var(--red);font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0}
.edit-btn{padding:5px 10px;background:var(--primary-light);border:1px solid #bfdbfe;border-radius:7px;color:var(--primary);font-size:11px;font-weight:700;cursor:pointer;flex-shrink:0;margin-right:6px}
.usr-row{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--border)}
.usr-row:last-child{border-bottom:none}
.usr-av{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Archivo Black',sans-serif;font-size:11px;flex-shrink:0}
.usr-nombre{font-size:13px;font-weight:700}
.usr-meta{font-size:11px;color:var(--muted);margin-top:1px}
.usr-rol{font-size:10px;font-weight:700;padding:2px 8px;border-radius:100px;white-space:nowrap}
.rol-admin{background:var(--primary-light);color:var(--primary);border:1px solid #bfdbfe}
.rol-delegado{background:#fdf4ff;color:#9333ea;border:1px solid #e9d5ff}
.btn-edit-sm{padding:5px 8px;border-radius:7px;background:var(--bg);color:var(--muted);border:1px solid var(--border);font-size:11px;font-weight:700;cursor:pointer}
.btn-del-sm{padding:5px 8px;border-radius:7px;background:var(--red-light);color:var(--red);border:1px solid #fecaca;font-size:11px;font-weight:700;cursor:pointer}
#drawer-overlay{position:fixed;inset:0;z-index:150;background:rgba(15,23,42,.5);backdrop-filter:blur(4px);display:none;align-items:flex-start;justify-content:flex-start}
#drawer-overlay.open{display:flex}
#drawer{background:var(--surface);width:72vw;max-width:280px;height:100%;display:flex;flex-direction:column;box-shadow:4px 0 24px rgba(0,0,0,.12);animation:slideRight .25s cubic-bezier(.32,1,.4,1)}
@keyframes slideRight{from{transform:translateX(-100%)}to{transform:translateX(0)}}
.drawer-top{padding:20px 20px 16px;border-bottom:1px solid var(--border)}
.drawer-nav{flex:1;padding:12px 0}
.drawer-section{font-size:10px;font-weight:700;color:var(--muted2);letter-spacing:1px;text-transform:uppercase;padding:12px 20px 4px}
.drawer-item{display:flex;align-items:center;gap:12px;padding:13px 20px;cursor:pointer;font-size:14px;font-weight:700;color:var(--muted);border:none;background:none;width:100%;text-align:left}
.drawer-item:hover,.drawer-item.active{color:var(--primary);background:var(--primary-light)}
.drawer-item svg{width:20px;height:20px;flex-shrink:0}
#toast{position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(10px);background:var(--text);color:#fff;padding:10px 20px;border-radius:100px;font-size:13px;font-weight:700;opacity:0;transition:all .3s;z-index:500;white-space:nowrap;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.ok{background:var(--green)}#toast.err{background:var(--red)}
/* === ADMIN MOBILE — grid de secciones === */
@media(max-width:640px){
  #admin-panel-full{flex-direction:column!important}
  #adm-sidebar{display:none!important}
  #adm-main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0}
  /* Por defecto en mobile: mostrar grid, ocultar panel y titlebar */
  #adm-main > .adm-titlebar{display:none}
  #adm-back-btn{display:none}
  #adm-main-content{display:none!important;padding-bottom:80px!important}
  #adm-home-grid{display:none}
  /* Cuando está en modo panel: ocultar grid, mostrar panel */
  #adm-main.panel-mode > .adm-titlebar{display:flex!important;flex-shrink:0}
  #adm-main.panel-mode #adm-back-btn{display:flex!important;flex-shrink:0}
  #adm-main.panel-mode #adm-main-content{display:block!important;flex:1;overflow-y:auto;min-height:0}
  #adm-main.panel-mode #adm-home-grid{display:none!important}
  /* Cuando está en modo grid: mostrar grid, ocultar panel */
  #adm-main.grid-mode #adm-home-grid{display:grid!important;flex:1;overflow-y:auto;min-height:0}
  #adm-main.grid-mode #adm-main-content{display:none!important}
  #adm-main.grid-mode > .adm-titlebar{display:none!important}
  #adm-main.grid-mode #adm-back-btn{display:none!important}
}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@media(min-width:640px){
  .confirm-v3-overlay{align-items:center;justify-content:center;padding:20px}
  .confirm-v3-box{border-radius:20px;max-width:480px}
}

/* === GRID ADMIN MOBILE ===*/
#adm-home-grid{display:none;grid-template-columns:1fr 1fr;gap:10px;padding:14px 14px 80px;background:#0a0e1f;overflow-y:auto;flex:1;min-height:0;align-content:start}
