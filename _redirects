function openAdmin(){const s=document.getElementById('splash-screen');if(s)s.style.display='none';document.getElementById('admin-overlay').classList.add('open');document.getElementById('admin-login-screen').style.display='flex';document.getElementById('admin-panel-full').style.display='none';}
function closeAdmin(){document.getElementById('admin-overlay').classList.remove('open');if(!adminPass||!_currentUser){const s=document.getElementById('splash-screen');if(s)s.style.display='flex';}}
async function doLogin(){
  const email=(document.getElementById('admin-email').value||'').trim().toLowerCase();
  const pass=document.getElementById('admin-pass').value;
  if(!email||!pass)return;
  const btn=document.getElementById('do-login'),txt=document.getElementById('login-btn-txt');
  txt.innerHTML='<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite;display:inline-block"></div> Ingresando...';btn.disabled=true;
  try{
    const res=await fetch(NETLIFY_FN,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'checkLogin',email,password:pass})});
    const json=JSON.parse(await res.text());
    if(json&&json.success){
      adminPass=pass;_currentUser=json.usuario;
      document.getElementById('admin-login-screen').style.display='none';
      document.getElementById('admin-panel-full').style.display='flex';
      if(window.innerWidth<=640){
        const main=document.getElementById('adm-main');
        main.classList.remove('panel-mode');
        main.classList.add('grid-mode');
      } else {
        admSetSection('torneo',document.querySelector('.adm-icon-btn[data-sec="torneo"]'));
      }
      const n=document.getElementById('adm-user-nombre');if(n)n.textContent=json.usuario.nombre;
      const ta=(D.temporadas||[]).find(t=>t.estado==='activa');
      const tb=document.getElementById('adm-temporada-badge');if(tb&&ta){tb.textContent=ta.nombre;tb.style.display='block';}
      renderAdmin();
      toast('Bienvenido, '+json.usuario.nombre,'ok');
      // En mobile → mostrar grid; en desktop → sidebar normal
      if(window.innerWidth<=640){
        admShowGrid();
      } else {
        admSetSection('torneo',document.querySelector('.adm-icon-btn[data-sec="torneo"]'));
      }
    }else{document.getElementById('login-error').style.display='block';setTimeout(()=>document.getElementById('login-error').style.display='none',2500);}
  }catch(e){toast('Error: '+e.message,'err');}
  finally{txt.textContent='Ingresar →';btn.disabled=false;}
}
