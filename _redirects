function pdfHeader(doc,titulo,sub){doc.setFillColor(30,58,138);doc.rect(0,0,297,22,'F');doc.setTextColor(255,255,255);doc.setFontSize(13);doc.setFont('helvetica','bold');doc.text('ARBA ARICA',14,10);doc.setFontSize(9);doc.setFont('helvetica','normal');doc.text('Asociación Regional de Básquetbol',14,15);doc.setFontSize(12);doc.setFont('helvetica','bold');doc.text(titulo,148,10,{align:'center'});doc.setFontSize(9);doc.setFont('helvetica','normal');doc.text(sub,148,16,{align:'center'});doc.text('Generado: '+new Date().toLocaleDateString('es-CL'),283,10,{align:'right'});doc.setTextColor(30,58,138);}
window.downloadPDF=function(tipo){
  const sufMap={fixture:'fixture',resultados:'res',puntaje:'pts'};const suf=sufMap[tipo]||tipo;
  const ligaEl=document.getElementById('rep-liga-'+suf);const eqEl=tipo==='puntaje'?null:document.getElementById('rep-eq-'+suf);
  const ligaId=ligaEl?.value||'';const eqId=eqEl?.value||'';
  const liga=ligaId?D.ligas.find(l=>l.ID===ligaId):null;const equipo=eqId?D.equipos.find(e=>e.ID===eqId):null;
  const{jsPDF}=window.jspdf;const doc=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});
  const sub=[liga?.NombreFantasia,equipo?.NombreEquipo].filter(Boolean).join(' · ')||'Todas las categorías';
  if(tipo==='fixture'){
    pdfHeader(doc,'FIXTURE',sub);
    let pts=D.partidos.filter(p=>p.Estado==='Programado');
    if(ligaId)pts=pts.filter(p=>p.ID_Liga===ligaId);if(eqId)pts=pts.filter(p=>p.ID_EquipoLocal===eqId||p.ID_EquipoVisita===eqId);
    doc.autoTable({startY:26,head:[['Fecha','Hora','Local','','Visita','Cancha','Fase']],body:pts.length?pts.map(p=>[fmtDate(p.Fecha),p.Hora||'—',teamName(p.ID_EquipoLocal),'vs',teamName(p.ID_EquipoVisita),p.Cancha||'—',p.Fase||'—']):[['Sin partidos','','','','','','']],styles:{fontSize:9,cellPadding:3},headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},alternateRowStyles:{fillColor:[239,246,255]},columnStyles:{3:{halign:'center',fontStyle:'bold'}}});
  }else if(tipo==='resultados'){
    pdfHeader(doc,'RESULTADOS',sub);
    let pts=D.partidos.filter(p=>p.Estado==='Finalizado');
    if(ligaId)pts=pts.filter(p=>p.ID_Liga===ligaId);if(eqId)pts=pts.filter(p=>p.ID_EquipoLocal===eqId||p.ID_EquipoVisita===eqId);
    doc.autoTable({startY:26,head:[['Fecha','Local','Pts','—','Pts','Visita','Fase']],body:pts.length?pts.map(p=>[fmtDate(p.Fecha),teamName(p.ID_EquipoLocal),String(p.GolesLocal??'—'),'-',String(p.GolesVisita??'—'),teamName(p.ID_EquipoVisita),p.Fase||'—']):[['Sin resultados','','','','','','']],styles:{fontSize:9,cellPadding:3},headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},alternateRowStyles:{fillColor:[239,246,255]},columnStyles:{2:{halign:'right',fontStyle:'bold'},3:{halign:'center'},4:{halign:'left',fontStyle:'bold'}}});
  }else if(tipo==='puntaje'){
    pdfHeader(doc,'TABLA DE POSICIONES',sub);
    const ligas=ligaId?D.ligas.filter(l=>l.ID===ligaId):D.ligas;let y=26;
    ligas.forEach(l=>{
      const st=calcStandings(l.ID);if(!st.length)return;
      doc.setFontSize(10);doc.setFont('helvetica','bold');doc.setTextColor(30,58,138);doc.text(l.NombreFantasia+' — '+l.Categoria,14,y+4);
      doc.autoTable({startY:y+7,head:[['Pos','Equipo','PJ','G','P','Pts','PF','PC','Dif']],body:st.map((s,i)=>[i+1,s.NombreEquipo,s.PJ,s.PG,s.PP,s.Puntos,s.GF,s.GC,(s.DG>0?'+':'')+s.DG]),styles:{fontSize:9,cellPadding:2.5},headStyles:{fillColor:[30,58,138],textColor:255,fontStyle:'bold'},alternateRowStyles:{fillColor:[239,246,255]},columnStyles:{0:{halign:'center',cellWidth:12},2:{halign:'center'},3:{halign:'center'},4:{halign:'center'},5:{halign:'center',fontStyle:'bold'},6:{halign:'center'},7:{halign:'center'},8:{halign:'center'}}});
      y=doc.lastAutoTable.finalY+10;if(y>170){doc.addPage();y=14;}
    });
  }
  doc.save('ARBA_'+tipo+'_'+new Date().toISOString().split('T')[0]+'.pdf');toast('✓ PDF descargado','ok');
};

