var _splashLigaActual=null;

// === ROUTING (URL por liga, sin recarga) ===
function slugify(str){
  return (str||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'') // quita tildes
    .toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
}
function ligaSlug(liga){return slugify(liga.NombreFantasia)||liga.ID;}
function findLigaBySlug(slug){return D.ligas.find(l=>ligaSlug(l)===slug);}
function urlParaLiga(ligaId){
  if(ligaId==='TODAS')return'/liga/todas';
  const liga=ligaObj(ligaId);
  return liga?('/liga/'+ligaSlug(liga)):'/';
}
function ligaIdDesdeURL(){
  const m=location.pathname.match(/^\/liga\/([^/]+)\/?$/);
  if(!m)return null;
  const slug=decodeURIComponent(m[1]);
  if(slug==='todas')return'TODAS';
  const liga=findLigaBySlug(slug);
  return liga?liga.ID:null;
}
window.addEventListener('popstate',function(){
  const ligaId=ligaIdDesdeURL();
  if(ligaId)selectSplashLiga(ligaId,{skipPush:true});
  else if(D.ligas.length)selectSplashLiga(D.ligas[0].ID,{skipPush:true});
});

