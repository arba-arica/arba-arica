      <div style="text-align:center;margin-bottom:32px">
        <div style="font-family:'Archivo Black',sans-serif;font-size:11px;font-weight:700;letter-spacing:3px;color:rgba(255,255,255,.4);margin-bottom:8px">BASQUET XV REGIÓN</div>
