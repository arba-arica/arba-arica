(255,255,255,.5);text-align:center">${s.GF}</td><td style="padding:10px 6px;font-size:12px;color:rgba(255,255,255,.5);text-align:center">${s.GC}</td><td style="padding:10px 6px;font-size:12px;color:${dif>0?'#86efac':dif<0?'#fca5a5':'rgba(255,255,255,.5)'};text-align:center">${dif>0?'+':''}${dif}</td><td style="padding:10px 10px;font-size:14px;font-weight:700;color:#f97316;text-align:center">${s.Puntos}</td></tr>`;}).join('')}</tbody></table></div>`;
  }
  html+=secT('REPORTES','14px');
  html+=`<button onclick="splashPDF('fixture')" style="width:100%;display:flex;align-items:center;gap:10px;padding:12px 14px;background:#1e3a8a;border:none;border-radius:10px;cursor:pointer;margin-bottom:6px"><svg width="18" height="18" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span style="font-size:13px;font-weight:700;color:#fff">Fixture PDF</span></button>
