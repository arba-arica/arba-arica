      <span class="match-status ${statusCls}">${statusTxt}</span>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px"><span style="font-size:10px;font-weight:700;color:var(--muted);letter-spacing:.3px;text-transform:uppercase">${liga?liga.NombreFantasia:''}${faseBadge}</span></div>
    <div class="match-body">
      <div class="team-side"><div class="team-color" style="background:${teamColor(p.ID_EquipoLocal,'local')}"></div><div class="team-name${lWin?' winner':''}">${teamName(p.ID_EquipoLocal)}</div></div>
      <div class="score-block">${scoreBlock}</div>
      <div class="team-side right"><div class="team-color" style="background:${teamColor(p.ID_EquipoVisita,'visita')};margin-left:auto"></div><div class="team-name${vWin?' winner':''}">${teamName(p.ID_EquipoVisita)}</div></div>
    </div>
    <div class="match-footer">
