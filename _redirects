}
function splashPDF(tipo){
  if(!_splashLigaActual)return toast('Selecciona una liga primero','err');
  const sufMap={fixture:'fixture',resultados:'res',puntaje:'pts'};const suf=sufMap[tipo]||tipo;
  const el=document.getElementById('rep-liga-'+suf);if(el)el.value=_splashLigaActual;
  downloadPDF(tipo);
}

// === ADMIN MOBILE GRID ===
function admIsGridMode(){return window.innerWidth<=640;}

function admShowGrid(){
  if(!admIsGridMode())return;
  const main=document.getElementById('adm-main');
  main.classList.remove('panel-mode');
  main.classList.add('grid-mode');
  document.querySelectorAll('.adm-panel-new').forEach(p=>p.style.display='none');
}

function admGridGo(tabId){
  if(!admIsGridMode()){admSetTab(tabId,null);return;}
  const main=document.getElementById('adm-main');
  main.classList.remove('grid-mode');
  main.classList.add('panel-mode');
  admSetTab(tabId,null);
}

